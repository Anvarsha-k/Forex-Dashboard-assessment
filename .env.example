# Free API key from https://www.tiingo.com (Account -> API -> Token)
MARKET_DATA_API_KEY=

# Used when running the backend outside Docker (docker compose sets its own).
DATABASE_URL=postgres://forex:forex@localhost:5433/forex?sslmode=disable

PORT=8080

# Optional
# MARKET_SYMBOLS=EUR/USD,GBP/USD,USD/JPY,USD/INR
# DB_MAX_CONNS=10
# DB_MIN_CONNS=2
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Redis is intentionally not used - see README "Design decisions".
